{
  "manifest_version": 3,
  "name": "My School Assignment Statuses",
  "version": "0.2.1",
  "description": "Personal calendar status colors with Chrome Sync across your signed-in browsers.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.myschoolapp.com/*"
      ],
      "js": [
        "identity.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
